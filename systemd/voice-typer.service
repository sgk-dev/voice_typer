[Unit]
Description=voice_typer — push-to-talk speech daemon
After=graphical-session.target

[Service]
Type=simple
ExecStart=/home/sgk/.venvs/transcribe/bin/python /home/sgk/voice_typer/voice_typer/main.py
Restart=on-failure
RestartSec=3
Environment=LD_LIBRARY_PATH=/home/sgk/.venvs/transcribe/lib/python3.12/site-packages/nvidia/cublas/lib:/home/sgk/.venvs/transcribe/lib/python3.12/site-packages/nvidia/cudnn/lib

[Install]
WantedBy=default.target
